{
  "name": "cs-club-leaderboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plano East Senior High School CS Club leaderboard and STEM opportunity board",
  "scripts": {
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "vite build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "sync:live": "node scripts/sync-from-live.mjs",
    "build:seed": "node scripts/build-seed-sql.mjs",
    "db:schema": "wrangler d1 execute cs-club --remote --file worker/schema.sql",
    "db:seed": "wrangler d1 execute cs-club --remote --file worker/seed.sql",
    "db:schema:local": "wrangler d1 execute cs-club --local --file worker/schema.sql",
    "db:seed:local": "wrangler d1 execute cs-club --local --file worker/seed.sql",
    "build:problems": "node scripts/import-problems.mjs",
    "db:problems:local": "wrangler d1 execute cs-club --local --file worker/seed-problems.sql",
    "ingest": "node ingest/run.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "hono": "^4.13.3",
    "pyodide": "^0.27.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "cheerio": "^1.0.0",
    "framer-motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5",
    "wrangler": "^4.124.0"
  }
}
